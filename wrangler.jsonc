{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landbark-pos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  // nodejs_compat จำเป็นเพราะ proxy.ts ของ Next 16 รันบน Node runtime เสมอ
  // (และ src/lib/shopee.ts เรียก createHmac จาก node:crypto)
  // global_fetch_strictly_public ทำให้ fetch ไปโดเมนตัวเองออกทางอินเทอร์เน็ตจริง ไม่วนกลับเข้า worker
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // ⚠️ บัญชี arm.maniii (Workers Paid) — ห้ามเป็น b2b4963d... ซึ่งเป็นบัญชี joodfangkhem แพ็กฟรี
  // เผลอขึ้นบัญชีฟรีจะเจอเพดาน CPU 10 ms แล้วพังโดยหาสาเหตุยาก
  "account_id": "804de54b064396831bb303d9b7dd9b49",

  // โดเมนจริงของ POS (จด landbark.app เมื่อ 31 ต.ค. 2026 ใต้บัญชีเดียวกับ worker)
  // custom_domain = Cloudflare สร้าง DNS + ออกใบ SSL ให้เอง ไม่ต้องตั้ง record มือ
  "routes": [
    // โดเมนพนักงาน — เปิดมาเจอหน้างาน (ดู src/lib/staff-host.ts)
    { "pattern": "pos.landbark.app", "custom_domain": true },
    // หน้าร้านของลูกค้า — เว็บเดียวกัน แยกกันที่ host
    { "pattern": "landbark.app", "custom_domain": true },
    { "pattern": "www.landbark.app", "custom_domain": true }
  ],

  // ใช้ทำลิงก์กดกลับเข้าหลังร้านในข้อความ Telegram เท่านั้น — ที่นั่นไม่มี request ให้อ้าง origin
  // (หน้าเว็บใช้ origin ของ request เอง เพราะ worker เดียวเสิร์ฟทั้งโดเมนลูกค้าและโดเมนพนักงาน)
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://pos.landbark.app"
  },

  // Worker ปกติรันที่ edge ใกล้คนกด แต่ Supabase อยู่สิงคโปร์ หน้าที่ยิงหลาย query
  // จึงเสียค่าเดินทางคูณจำนวนครั้ง (วัดได้ /shop ช้ากว่า Vercel ที่ตั้ง regions sin1 อยู่ ~2 เท่า)
  // smart = Cloudflare ย้ายไปรันใกล้ปลายทางให้เองเมื่อเห็นว่า request คุยหลังบ้านหนัก
  "placement": { "mode": "smart" },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "landbark-pos"
    }
  ],
  // ที่เก็บผลของ route ที่ตั้ง revalidate ไว้ (เช่น /api/favicon)
  // Worker ทำงานก่อนแคช CDN เสมอ response จึงไม่เคยผ่านแคชชั้นนั้น ต้องมีที่เก็บของตัวเอง
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "landbark-pos-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
