{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "landbark-pos-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // บัญชี arm.maniii (Workers Paid) — ต้องตรงกับ wrangler.jsonc ของตัวเว็บ
  "account_id": "804de54b064396831bb303d9b7dd9b49",

  // worker นี้ไม่รับ request จากอินเทอร์เน็ต ปลุกด้วยตารางเวลาอย่างเดียว
  "workers_dev": false,

  // เวลาเป็น UTC เหมือน vercel.json เดิม → 01:00 UTC = 08:00 ไทย, 13:00 UTC = 20:00 ไทย
  "triggers": {
    "crons": ["0 1 * * *", "0 13 * * *"]
  },

  "vars": {
    // ตั้งเป็นโดเมนจริงเมื่อย้ายโดเมนมาแล้ว ระหว่างทดสอบชี้ไป workers.dev ได้
    "POS_URL": "https://landbark-pos.workers.dev"
  },

  "observability": {
    "enabled": true
  }
}
