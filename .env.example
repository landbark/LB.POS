# ก๊อปไฟล์นี้เป็น .env แล้วเติมค่าจริง — ค่าทั้งหมดดึงจาก Vercel ได้ที่
# Project Settings → Environment Variables
#
#   cp .env.example .env
#
# .env มีกุญแจที่เปิดฐานข้อมูลได้ทั้งหมด ห้ามขึ้น git (.gitignore กันไว้แล้ว)

# ---- โดเมนที่จะให้ Caddy ขอใบ HTTPS ให้ (ใช้เฉพาะตอน deploy) ----
DOMAIN=pos.example.com

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ข้ามทุก RLS — รั่วเมื่อไหร่คือเปิดฐานข้อมูลทั้งร้านให้คนอื่น
SUPABASE_SERVICE_ROLE_KEY=

# ---- ที่อยู่เว็บ (ใช้ทำลิงก์ในข้อความแจ้งเตือน + callback ของ LINE) ----
NEXT_PUBLIC_SITE_URL=https://pos.example.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ---- LINE (ลูกค้าเช็คแต้มผ่าน LIFF + ล็อกอินหน้าร้านออนไลน์) ----
NEXT_PUBLIC_LIFF_ID=
LINE_LIFF_CHANNEL_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ---- เซสชันลูกค้าหน้าร้านออนไลน์ ----
CUSTOMER_SESSION_SECRET=

# ---- cron (ตั้ง crontab ให้แนบค่านี้มาใน Authorization: Bearer) ----
CRON_SECRET=
